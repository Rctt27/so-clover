# Copier en .env (gitignoré) et remplacer chaque valeur.
# Générer les secrets : openssl rand -hex 32
# ENCRYPTION_KEY doit faire exactement 64 caractères hexadécimaux.
NEXTAUTH_SECRET=remplacer-par-openssl-rand-hex-32
SALT=remplacer-par-openssl-rand-hex-32
ENCRYPTION_KEY=remplacer-par-64-caracteres-hex
POSTGRES_PASSWORD=remplacer
CLICKHOUSE_PASSWORD=remplacer
REDIS_AUTH=remplacer
MINIO_ROOT_PASSWORD=remplacer
LANGFUSE_INIT_ORG_ID=soclover
LANGFUSE_INIT_ORG_NAME=SoClover
LANGFUSE_INIT_PROJECT_ID=soclover-eval
LANGFUSE_INIT_PROJECT_NAME=SoClover Eval
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-soclover-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-remplacer
LANGFUSE_INIT_USER_EMAIL=remplacer@example.com
LANGFUSE_INIT_USER_NAME=Auteur
LANGFUSE_INIT_USER_PASSWORD=remplacer
