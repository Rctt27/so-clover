# Ignore Windows/host build outputs so they don't enter Linux builds
SoClover/**/bin
SoClover/**/obj
SoClover.Tests/**/bin
SoClover.Tests/**/obj
SoClover.Eval/**/bin
SoClover.Eval/**/obj

# Eval harness : le Dockerfile ne restaure/publie que SoClover/SoClover.csproj, jamais
# SoClover.Eval ni le .sln - ces dossiers n'ont aucune raison d'entrer dans le contexte Docker
eval

# Frontend build outputs
SoClover/client/dist
SoClover/client/node_modules

# General noise
.git
.vs
.idea
**/*.user
**/*.suo
*.tgz
node_modules
npm-debug.log
*.log

# Docker and CI
docker-compose.yml
docker-compose.*.yml
Dockerfile
.dockerignore
.github

# IDE
.vscode
.vscode/**/*

# Environment and local
.env
.env.local
.claude
.output.txt

# Other
.gitignore
README.md
CLAUDE.md
nul
